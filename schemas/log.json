{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ha-notice/log.json",
  "title": "ha-notice log.jsonl record",
  "description": "One record per send outcome that reaches step 3 (input) or later: sent, refused (exit 20), outcome_unknown (exit 12 whenever the envelope's unknown_outcome is true) or failed (any other exit 12). Not logged: exit 1, exit 2, exit 22 and dry runs. Never contains a title, message, link, base URL, service name or credential. A field that does not apply is null.",
  "type": "object",
  "properties": {
    "ts": {
      "$ref": "defs.json#/$defs/ts"
    },
    "tool": {
      "$ref": "defs.json#/$defs/tool"
    },
    "version": {
      "type": "string",
      "maxLength": 64
    },
    "outcome": {
      "enum": [
        "sent",
        "refused",
        "failed",
        "outcome_unknown"
      ],
      "description": "sent: exit 0; refused: exit 20; outcome_unknown: exit 12 with unknown_outcome true (outcome_unknown, upstream_error, or a wrong_host_response for a 2xx); failed: any other exit 12."
    },
    "exit": {
      "enum": [
        0,
        12,
        20
      ],
      "description": "Only exits that reach step 3 or later are logged."
    },
    "code": {
      "oneOf": [
        {
          "$ref": "defs.json#/$defs/error_code"
        },
        {
          "type": "null"
        }
      ]
    },
    "reason": {
      "oneOf": [
        {
          "$ref": "defs.json#/$defs/refusal_reason"
        },
        {
          "type": "null"
        }
      ]
    },
    "level": {
      "oneOf": [
        {
          "$ref": "defs.json#/$defs/level"
        },
        {
          "type": "null"
        }
      ]
    },
    "bytes": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "truncated": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 0,
      "description": "From the start of input reading to just before the log write; never null."
    },
    "http_status": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 100,
      "maximum": 599
    },
    "message_sha256": {
      "oneOf": [
        {
          "$ref": "defs.json#/$defs/sha16"
        },
        {
          "type": "null"
        }
      ]
    },
    "dedupe_key_sha256": {
      "oneOf": [
        {
          "$ref": "defs.json#/$defs/sha16"
        },
        {
          "type": "null"
        }
      ]
    },
    "tag_set": {
      "type": [
        "boolean",
        "null"
      ],
      "description": "Null when no request was built."
    },
    "actor": {
      "$ref": "defs.json#/$defs/actor"
    },
    "actor_source": {
      "$ref": "defs.json#/$defs/actor_source"
    }
  },
  "required": [
    "ts",
    "tool",
    "version",
    "outcome",
    "exit",
    "code",
    "reason",
    "level",
    "bytes",
    "truncated",
    "duration_ms",
    "http_status",
    "message_sha256",
    "dedupe_key_sha256",
    "tag_set",
    "actor",
    "actor_source"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "sent"
          }
        }
      },
      "then": {
        "properties": {
          "exit": {
            "const": 0
          },
          "code": {
            "type": "null"
          },
          "reason": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "refused"
          }
        }
      },
      "then": {
        "properties": {
          "exit": {
            "const": 20
          },
          "code": {
            "const": "refused"
          },
          "reason": {
            "$ref": "defs.json#/$defs/refusal_reason"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "failed"
          }
        }
      },
      "then": {
        "properties": {
          "exit": {
            "const": 12
          },
          "code": {
            "enum": [
              "host_rejected",
              "auth_required",
              "credential_invalid",
              "rate_limited",
              "network_error",
              "wrong_host_response"
            ]
          },
          "reason": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "outcome_unknown"
          }
        }
      },
      "then": {
        "properties": {
          "exit": {
            "const": 12
          },
          "code": {
            "enum": [
              "outcome_unknown",
              "upstream_error",
              "wrong_host_response"
            ]
          },
          "reason": {
            "type": "null"
          }
        }
      }
    }
  ]
}
