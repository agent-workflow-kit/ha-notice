{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ha-notice/cli/validate.json",
  "title": "validate output",
  "description": "Printed with --json when the config loads. enabled is the configured value. Checks run in the order config, credential, probe, test_message; a failed check ends the run and later checks are omitted, so ok is true only when every printed check is ok. Exit 0 when ok, else the exit code of the failing check (config 2; credential, probe, test_message 12); exit 22 when enabled is false (then only config and credential run). When the config cannot load, the output is the error envelope with exit 2. probe is present only with --probe; the probe and test_message checks only with --probe and --test-message.",
  "type": "object",
  "properties": {
    "ok": {
      "type": "boolean"
    },
    "enabled": {
      "type": "boolean"
    },
    "probe": {
      "type": "object",
      "description": "Present only with --probe (GET /api/).",
      "properties": {
        "api_ok": {
          "type": "boolean"
        }
      },
      "required": [
        "api_ok"
      ],
      "additionalProperties": false
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "enum": [
              "config",
              "credential",
              "probe",
              "test_message"
            ]
          },
          "ok": {
            "type": "boolean"
          },
          "message": {
            "type": "string",
            "x-untrusted": true,
            "maxLength": 1024,
            "description": "Untrusted: may quote host text. Never contains the token."
          }
        },
        "required": [
          "name",
          "ok",
          "message"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "ok",
    "enabled",
    "checks"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "enabled": {
            "const": false
          }
        },
        "required": [
          "enabled"
        ]
      },
      "then": {
        "not": {
          "required": [
            "probe"
          ]
        },
        "properties": {
          "checks": {
            "items": {
              "properties": {
                "name": {
                  "enum": [
                    "config",
                    "credential"
                  ]
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "checks": {
            "contains": {
              "properties": {
                "ok": {
                  "const": false
                }
              },
              "required": [
                "ok"
              ]
            }
          }
        },
        "required": [
          "checks"
        ]
      },
      "then": {
        "properties": {
          "ok": {
            "const": false
          }
        }
      },
      "else": {
        "properties": {
          "ok": {
            "const": true
          }
        }
      }
    }
  ]
}
