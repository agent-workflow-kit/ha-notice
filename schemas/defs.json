{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ha-notice/defs.json",
  "title": "ha-notice shared definitions",
  "description": "Not an output on its own. Shared definitions referenced by the notification, CLI and log schemas. config.json is self-contained and embeds its own copies.",
  "$defs": {
    "tool": {
      "const": "ha-notice"
    },
    "level": {
      "enum": [
        "info",
        "warn",
        "action",
        "error"
      ],
      "description": "Ordered info < warn < action < error; the order matters to callers, not to ha-notice."
    },
    "ts": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}[Tt][0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:[Zz]|[+-][0-9]{2}:[0-9]{2})$",
      "description": "RFC 3339."
    },
    "sha16": {
      "type": "string",
      "pattern": "^[0-9a-f]{16}$",
      "description": "First 16 hex characters of a SHA-256."
    },
    "dedupe_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "description": "--dedupe-key: any non-empty string of at most 1024 characters; only hashed."
    },
    "actor": {
      "type": "string",
      "pattern": "^(human|auto):[A-Za-z0-9._@/-]{1,64}$",
      "description": "human:<user> or auto:<name>. Advisory."
    },
    "actor_source": {
      "enum": [
        "flag",
        "tty",
        "default"
      ],
      "description": "How the actor was obtained."
    },
    "exit_code": {
      "enum": [
        0,
        1,
        2,
        12,
        20,
        22
      ],
      "description": "ha-notice's exit codes. 10, 11, 13 and 21 are never used."
    },
    "error_code": {
      "enum": [
        "usage",
        "config_invalid",
        "internal",
        "refused",
        "host_rejected",
        "auth_required",
        "credential_invalid",
        "rate_limited",
        "upstream_error",
        "network_error",
        "outcome_unknown",
        "wrong_host_response"
      ],
      "description": "Exit 20 always has code refused with a reason; the reasons are not codes."
    },
    "refusal_reason": {
      "enum": [
        "invalid_payload",
        "empty_message",
        "command_keyword",
        "link_invalid",
        "link_scheme"
      ]
    },
    "error_details": {
      "type": "object",
      "x-untrusted": true,
      "description": "Untrusted: may hold payload field names or host text. By code or reason: config_invalid -> key; reason invalid_payload -> pointer (may be the empty string); credential_invalid -> env; auth_required -> http_status; host_rejected -> http_status, hint; network_error -> tls, timeout.",
      "properties": {
        "key": {
          "type": "string",
          "maxLength": 256
        },
        "pointer": {
          "type": "string",
          "maxLength": 512,
          "description": "JSON pointer into the input."
        },
        "env": {
          "type": "string",
          "maxLength": 256
        },
        "http_status": {
          "type": "integer",
          "minimum": 100,
          "maximum": 599
        },
        "hint": {
          "type": "string",
          "maxLength": 512
        },
        "tls": {
          "type": "boolean"
        },
        "timeout": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "error": {
      "type": "object",
      "properties": {
        "code": {
          "$ref": "#/$defs/error_code"
        },
        "message": {
          "type": "string",
          "x-untrusted": true,
          "maxLength": 2048,
          "description": "Untrusted: may quote host or input text. Never contains the token."
        },
        "reason": {
          "oneOf": [
            {
              "$ref": "#/$defs/refusal_reason"
            },
            {
              "type": "null"
            }
          ],
          "description": "On exit 20; null elsewhere."
        },
        "details": {
          "oneOf": [
            {
              "$ref": "#/$defs/error_details"
            },
            {
              "type": "null"
            }
          ]
        },
        "retryable": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "A boolean on exit 12 and exit 1 (false), null on exit 2 and 20. Sending the same notification again is safe."
        },
        "retry_after_s": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "description": "Set only for rate_limited."
        },
        "unknown_outcome": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "A boolean on exit 12 and exit 1 (true when the request may have been delivered), null on exit 2 and 20."
        }
      },
      "required": [
        "code",
        "message"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "code": {
                "enum": [
                  "host_rejected",
                  "auth_required",
                  "credential_invalid",
                  "rate_limited",
                  "upstream_error",
                  "network_error",
                  "outcome_unknown",
                  "wrong_host_response"
                ]
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "required": [
              "retryable",
              "unknown_outcome"
            ],
            "properties": {
              "retryable": {
                "type": "boolean"
              },
              "unknown_outcome": {
                "type": "boolean"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "enum": [
                  "internal"
                ]
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "required": [
              "retryable",
              "unknown_outcome"
            ],
            "properties": {
              "retryable": {
                "const": false
              },
              "unknown_outcome": {
                "type": "boolean"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "enum": [
                  "usage",
                  "config_invalid",
                  "refused"
                ]
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "properties": {
              "retryable": {
                "type": "null"
              },
              "unknown_outcome": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "enum": [
                  "host_rejected",
                  "auth_required",
                  "credential_invalid"
                ]
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "required": [
              "retryable",
              "unknown_outcome"
            ],
            "properties": {
              "retryable": {
                "const": false
              },
              "unknown_outcome": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "enum": [
                  "rate_limited"
                ]
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "required": [
              "retryable",
              "unknown_outcome"
            ],
            "properties": {
              "retryable": {
                "const": true
              },
              "unknown_outcome": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "enum": [
                  "outcome_unknown",
                  "upstream_error"
                ]
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "properties": {
              "unknown_outcome": {
                "const": true
              },
              "retryable": {
                "type": "boolean"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "enum": [
                  "wrong_host_response"
                ]
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "properties": {
              "retryable": {
                "const": false
              },
              "unknown_outcome": {
                "type": "boolean"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "enum": [
                  "network_error"
                ]
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "properties": {
              "unknown_outcome": {
                "const": false
              }
            },
            "if": {
              "properties": {
                "details": {
                  "type": "object",
                  "required": [
                    "tls"
                  ],
                  "properties": {
                    "tls": {
                      "const": true
                    }
                  }
                }
              },
              "required": [
                "details"
              ]
            },
            "then": {
              "properties": {
                "retryable": {
                  "const": false
                }
              }
            },
            "else": {
              "properties": {
                "retryable": {
                  "const": true
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "enum": [
                  "rate_limited"
                ]
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "required": [
              "retry_after_s"
            ],
            "properties": {
              "retry_after_s": {
                "type": "number"
              }
            }
          },
          "else": {
            "properties": {
              "retry_after_s": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "enum": [
                  "refused"
                ]
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "required": [
              "reason"
            ],
            "properties": {
              "reason": {
                "$ref": "#/$defs/refusal_reason"
              }
            }
          },
          "else": {
            "properties": {
              "reason": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "reason": {
                "const": "invalid_payload"
              }
            },
            "required": [
              "reason"
            ]
          },
          "then": {
            "required": [
              "details"
            ],
            "properties": {
              "details": {
                "type": "object",
                "required": [
                  "pointer"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "enum": [
                  "credential_invalid"
                ]
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "required": [
              "details"
            ],
            "properties": {
              "details": {
                "type": "object",
                "required": [
                  "env"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "enum": [
                  "auth_required",
                  "host_rejected"
                ]
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "required": [
              "details"
            ],
            "properties": {
              "details": {
                "type": "object",
                "required": [
                  "http_status"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "enum": [
                  "config_invalid"
                ]
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "required": [
              "details"
            ],
            "properties": {
              "details": {
                "type": "object",
                "required": [
                  "key"
                ]
              }
            }
          }
        }
      ]
    }
  }
}
